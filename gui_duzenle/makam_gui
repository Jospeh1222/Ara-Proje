#PREDICTION THREAD - artik raw segment_images alir
#********************************************************************

class PredictionThread(QThread):
    progress_updated = pyqtSignal(int, int)
    status_updated = pyqtSignal(str)
    finished_success = pyqtSignal(list)
    finished_error = pyqtSignal(str)

    def __init__(self, segment_images, entry, parent=None):
        super().__init__(parent)
        self.segment_images = segment_images   # raw uint8 list
        self.entry = entry                     # tek bir ModelEntry

    def run(self):
        try:
            entry = self.entry
            self.progress_updated.emit(0, 1)
            self.status_updated.emit(f"Model yükleniyor: {entry.display_name}")

            if not entry.is_loaded:
                entry.load()

            if not entry.is_available:
                self.progress_updated.emit(1, 1)
                self.finished_success.emit([(entry, None)])
                return

            self.status_updated.emit(f"Tahmin yapılıyor: {entry.display_name}")
            try:
                result = entry.predict(self.segment_images)
                results = [(entry, result)]
            except Exception as e:
                entry.error_message = str(e)
                entry.is_available = False
                results = [(entry, None)]

            self.progress_updated.emit(1, 1)
            self.finished_success.emit(results)

        except Exception as e:
            self.finished_error.emit(f"Tahmin hatası: {e}")


